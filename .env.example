# After `npm run contracts:deploy:testnet`, this is filled automatically in
# your Git-ignored `.env.local` file. These two values are PUBLIC.
VITE_BEATDROP_ADDRESS=
VITE_MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Safe VS Code deployment (no Remix, no MetaMask private-key export):
# npm run deployer:prepare
# npm run deployer:status
# npm run contracts:compile
# npm run contracts:deploy:testnet
# npm run chain:check
#
# A TESTNET-only signer is generated automatically in your personal AppData
# directory OUTSIDE OneDrive; do NOT write a private key in this file or
# any VITE_* variable. Full guide: docs/VS_CODE_DEPLOY.md
