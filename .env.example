# Browser: PUBLIC Monad Testnet contract address from successful deployment.
# Save to .env.local and restart Vite. This is not a wallet secret.
VITE_BEATDROP_ADDRESS=
# Optional browser-callable public RPC endpoint, MUST be chain ID 10143.
# VITE_MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Server-side local deployment (optional, NOT VITE-prefixed):
# DEPLOYER_PRIVATE_KEY=0x...
# MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
# SOURCE_REVISION=git-commit-sha
